---
// Une position de candidat : valeur, citation exacte, source, date, confiance, relecture.
import { CONFIANCE, type Position } from '../lib/types';
import { dateFr, libelleValeur } from '../lib/donnees';

interface Props {
  position: Position | null | undefined;
  /** Titre affiché au-dessus (nom du candidat ou texte de la question). */
  titre?: string;
  titreHref?: string;
}
const { position: p, titre, titreHref } = Astro.props;
const connue = p && p.valeur !== null && p.valeur !== undefined;
let domaine = '';
try {
  domaine = p?.source ? new URL(p.source).hostname.replace(/^www\./, '') : '';
} catch {}
---

<article class="brut-surface bg-card p-4">
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
    {titre && (titreHref ? <h3 class="font-sans text-base font-bold"><a class="lien" href={titreHref}>{titre}</a></h3> : <h3 class="font-sans text-base font-bold">{titre}</h3>)}
    <span class:list={['brut-chip px-2 py-0.5 text-[0.7rem]', connue ? 'bg-secondary text-secondary-foreground' : 'bg-muted text-muted-foreground']}>
      {connue ? `${p!.valeur! > 0 ? '+' : ''}${p!.valeur} · ${libelleValeur(p!.valeur)}` : 'Position inconnue'}
    </span>
  </div>
  {connue ? (
    <>
      {p!.citation && (
        <blockquote class="mt-3 border-l-4 border-primary pl-3 text-[0.95rem] leading-relaxed">
          <p>« {p!.citation} »</p>
        </blockquote>
      )}
      {p!.resume && <p class="mt-2 text-sm text-muted-foreground"><span class="font-semibold text-foreground">Résumé : </span>{p!.resume}</p>}
      <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-muted-foreground">
        {p!.source && <a class="lien font-semibold text-foreground" href={p!.source}>Source{domaine && ` (${domaine})`}<span class="sr-only"> (site externe)</span></a>}
        {p!.date_source && <span>{dateFr(p!.date_source)}</span>}
        {p!.confiance && <span class="brut-chip px-1.5 py-0.5 text-[0.65rem]" title={CONFIANCE[p!.confiance]?.aide}>Confiance : {CONFIANCE[p!.confiance]?.libelle}</span>}
        {p!.relu ? <span class="brut-chip bg-primary px-1.5 py-0.5 text-[0.65rem] text-primary-foreground">Relu par un humain</span> : <span class="brut-chip px-1.5 py-0.5 text-[0.65rem]">Non relu</span>}
      </p>
    </>
  ) : (
    <p class="mt-2 text-sm text-muted-foreground">Aucune position publique sourcée n'a été trouvée : la boussole ne devine jamais à partir de l'étiquette politique.</p>
  )}
</article>
