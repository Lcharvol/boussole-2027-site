---
import '../styles/global.css';
import Icone from '../components/Icone';
import { dateFr, lien, meta } from '../lib/donnees';

interface Props {
  titre: string;
  description?: string;
  image?: string;
  /** Texte alternatif de l'image de partage. */
  imageAlt?: string;
  /** Exclut la page de l'indexation (pages de résultat). */
  noindex?: boolean;
  large?: boolean;
}
const {
  titre,
  description = 'Une boussole électorale neutre pour la présidentielle 2027 : 40 affirmations, 25 candidats, chaque position sourcée par une citation exacte relue par un humain. Calcul dans votre navigateur, aucune donnée collectée.',
  image = 'og/generique.png',
  imageAlt = 'Boussole présidentielle 2027 : proximité avec des programmes, pas une consigne de vote.',
  noindex = false,
  large = false,
} = Astro.props;
const titreComplet = titre === 'Accueil' ? 'Boussole présidentielle 2027' : `${titre} · Boussole présidentielle 2027`;
const canonique = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(lien(image), Astro.site);
const chemin = Astro.url.pathname;

const nav = [
  { href: 'test/', texte: 'Faire le test' },
  { href: 'candidats/', texte: 'Candidats' },
  { href: 'questions/', texte: 'Qui pense quoi' },
  { href: 'comparer/', texte: 'Comparer' },
  { href: 'methode/', texte: 'Méthode' },
  { href: 'calendrier/', texte: 'Calendrier' },
  { href: 'classe/', texte: 'En classe' },
  { href: 'skill-claude/', texte: 'Skill Claude' },
];
const actif = (href: string) => chemin.startsWith(lien(href));
---

<!doctype html>
<html lang="fr" data-brut-palette="paper" data-brut-strength="solid" data-brut-radius="cut">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href={lien('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={lien('sitemap.xml')} />
    <slot name="head" />
    <meta name="theme-color" content="#fbf9f1" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Boussole présidentielle 2027" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Thème clair par défaut ; le thème sombre s'active avec le bouton de l'en-tête, et ce choix est
      // mémorisé dans ce navigateur seulement (localStorage, pas de cookie). ?theme=sombre force le thème
      // sombre pour la page affichée, sans rien mémoriser (sert aux tests d'accessibilité).
      (function () {
        var t = 'light';
        try { if (localStorage.getItem('theme') === 'dark') t = 'dark'; } catch (e) {}
        if (/[?&]theme=sombre\b/.test(location.search)) t = 'dark';
        document.documentElement.dataset.theme = t;
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body class="bg-background text-foreground antialiased">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 brut-control bg-primary text-primary-foreground px-4 py-2">Aller au contenu</a>
    <header class="border-b-[length:var(--brut-border)] border-border bg-card">
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
        <a href={lien()} class="flex items-center gap-2 font-serif text-lg font-bold leading-tight" aria-label="Boussole 2027, accueil">
          <svg aria-hidden="true" viewBox="0 0 32 32" class="size-8 shrink-0"><circle cx="16" cy="16" r="14" fill="var(--card)" stroke="currentColor" stroke-width="2.5"></circle><path class="aiguille" d="M16 5 L20 16 L16 27 L12 16 Z" fill="var(--primary)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path><circle cx="16" cy="16" r="2" fill="currentColor"></circle></svg>
          <span>Boussole <span class="whitespace-nowrap">2027</span></span>
        </a>
        <nav aria-label="Navigation principale" class="ml-auto hidden lg:block">
          <ul class="flex flex-wrap items-center gap-1 text-sm font-semibold">
            {nav.map((n) => (
              <li>
                <a href={lien(n.href)} aria-current={actif(n.href) ? 'page' : undefined} class:list={['brut-quiet block px-2.5 py-1.5', actif(n.href) && 'bg-muted !border-border']}>{n.texte}</a>
              </li>
            ))}
          </ul>
        </nav>
        <button type="button" id="bouton-theme" class="brut-control brut-focus ml-auto inline-flex h-10 items-center gap-2 bg-background px-2.5 text-sm lg:ml-1" aria-pressed="false">
          <Icone client:idle nom="moon" className="icone-lune" />
          <Icone client:idle nom="sun" className="icone-soleil" />
          <span class="sr-only">Thème sombre</span>
        </button>
        <details class="relative lg:hidden" id="menu-mobile">
          <summary class="brut-control brut-focus flex h-10 list-none items-center gap-1.5 bg-background px-3 text-sm [&::-webkit-details-marker]:hidden"><Icone client:idle nom="menu" taille={18} />Menu</summary>
          <nav aria-label="Navigation principale (mobile)" class="brut-panel absolute right-0 z-40 mt-3 w-64 bg-card p-2">
            <ul class="grid gap-1 font-semibold">
              {nav.map((n) => (
                <li><a href={lien(n.href)} aria-current={actif(n.href) ? 'page' : undefined} class:list={['brut-quiet block px-3 py-2.5', actif(n.href) && 'bg-muted']}>{n.texte}</a></li>
              ))}
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="contenu" tabindex="-1" class:list={['mx-auto w-full px-4 py-8 sm:py-12 outline-none', large ? 'max-w-6xl' : 'max-w-4xl']}>
      <slot />
    </main>

    <footer class="mt-16 border-t-[length:var(--brut-border)] border-border bg-card">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm sm:grid-cols-[2fr_1fr_1fr]">
        <div class="space-y-3">
          <p class="font-serif text-base font-bold">Proximité avec des programmes, pas une consigne de vote.</p>
          <p class="text-muted-foreground">
            Aucun cookie, aucun traceur, aucun sondage. Vos réponses restent dans votre navigateur.
            Données : <a class="lien" href={meta.depot}>dépôt du skill</a>{meta.commit && <>, version <a class="lien font-mono" href={`${meta.depot}/commit/${meta.commit}`}>{meta.commit.slice(0, 7)}</a></>}{meta.date_commit && <> du {dateFr(meta.date_commit)}</>}.
          </p>
        </div>
        <nav aria-label="Pages du site">
          <ul class="grid gap-1.5">
            <li><a class="lien" href={lien('donnees/')}>Données ouvertes</a></li>
            <li><a class="lien" href={lien('methode/')}>Méthode et audit</a></li>
            <li><a class="lien" href={lien('a-propos/')}>À propos, contribuer</a></li>
          </ul>
        </nav>
        <nav aria-label="Informations légales">
          <ul class="grid gap-1.5">
            <li><a class="lien" href={lien('confidentialite/')}>Confidentialité</a></li>
            <li><a class="lien" href={lien('mentions-legales/')}>Mentions légales</a></li>
            <li><a class="lien inline-flex items-center gap-1.5" href="https://github.com/Lcharvol/boussole-2027-site"><Icone client:visible nom="github" taille={16} />Code source (MIT)</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var b = document.getElementById('bouton-theme');
        function maj() {
          var sombre = document.documentElement.dataset.theme === 'dark';
          b.setAttribute('aria-pressed', String(sombre));
          b.title = sombre ? 'Revenir au thème clair' : 'Passer au thème sombre';
        }
        maj();
        b.addEventListener('click', function () {
          var t = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = t;
          try { localStorage.setItem('theme', t); } catch (e) {}
          maj();
        });
        var m = document.getElementById('menu-mobile');

        // Apparition au défilement : [data-revele] ; les enfants directs de [data-cascade] apparaissent
        // les uns après les autres. Compteurs : [data-compteur] compte jusqu'à sa valeur finale.
        var calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.querySelectorAll('[data-cascade]').forEach(function (g) {
          Array.prototype.forEach.call(g.children, function (e, i) {
            e.setAttribute('data-revele', '');
            e.style.setProperty('--delai', Math.min(i, 8) * 70 + 'ms');
          });
        });
        function compter(e) {
          var fin = Number(e.getAttribute('data-compteur'));
          if (calme || !fin) return;
          var t0 = null;
          function pas(t) {
            if (t0 === null) t0 = t;
            var x = Math.min(1, (t - t0) / 1100);
            e.textContent = String(Math.round(fin * (1 - Math.pow(1 - x, 3))));
            if (x < 1) requestAnimationFrame(pas);
          }
          requestAnimationFrame(pas);
        }
        if (!calme) document.querySelectorAll('[data-compteur]').forEach(function (e) { e.textContent = '0'; });
        var cibles = document.querySelectorAll('[data-revele], [data-compteur]');
        if (!('IntersectionObserver' in window)) {
          cibles.forEach(function (e) { e.classList.add('est-visible'); });
        } else {
          var io = new IntersectionObserver(function (entrees) {
            entrees.forEach(function (en) {
              if (!en.isIntersecting) return;
              en.target.classList.add('est-visible');
              if (en.target.hasAttribute('data-compteur')) compter(en.target);
              io.unobserve(en.target);
            });
          }, { rootMargin: '0px 0px -8% 0px' });
          cibles.forEach(function (e) { io.observe(e); });
        }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && m.open) { m.open = false; m.querySelector('summary').focus(); } });
        // Un clic hors du menu mobile le referme.
        document.addEventListener('click', function (e) { if (m.open && !m.contains(e.target)) m.open = false; });
      })();
    </script>
  </body>
</html>
