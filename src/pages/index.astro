---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import Icone from '../components/Icone';
import { candidats, dateFr, lien, listeQuestions, meta, questions, themes } from '../lib/donnees';
import { calendrier } from '../data/calendrier';

const exemple = listeQuestions.find((q) => q.niveau === 'rapide') ?? listeQuestions[0];

const aujourdhui = new Date().toISOString().slice(0, 10);
const prochaines = calendrier.filter((e) => e.date && e.date >= aujourdhui).slice(0, 3);

const differences: { titre: string; texte: string; icone: 'book-text' | 'gauge' | 'layers' | 'circle-help' | 'shield-check' | 'download' }[] = [
  {
    icone: 'book-text',
    titre: 'Chaque position a sa citation',
    texte: `Les ${meta.nb_positions} positions renseignées s'appuient sur une phrase exacte, recopiée depuis la source, avec le lien, la date et un niveau de confiance. ${meta.nb_positions_relues === meta.nb_positions ? 'Toutes ont été relues par un humain.' : `${meta.nb_positions_relues} ont été relues par un humain.`}`,
  },
  {
    icone: 'gauge',
    titre: 'La neutralité est mesurée, pas affirmée',
    texte: "Un audit publié teste le calcul avec des milliers de profils au hasard et vérifie qu'aucun camp n'est avantagé mécaniquement. Les chiffres sont recalculés à chaque mise à jour des données.",
  },
  {
    icone: 'layers',
    titre: 'Une marge, pas un faux classement',
    texte: "Chaque score est donné avec sa marge d'incertitude. Quand deux candidats sont trop proches pour être départagés, le résultat le dit.",
  },
  {
    icone: 'circle-help',
    titre: 'On ne devine jamais',
    texte: "Sans source, la position reste inconnue et c'est affiché. La part des questions couvertes est indiquée pour chaque candidat.",
  },
  {
    icone: 'shield-check',
    titre: 'Rien ne quitte votre appareil',
    texte: 'Le calcul se fait dans votre navigateur. Aucun compte, aucun cookie, aucun traceur, aucune statistique sur les réponses.',
  },
  {
    icone: 'download',
    titre: 'Tout est ouvert',
    texte: 'Questions, positions, sources et calcul sont publics et téléchargeables. Une erreur ? Chacun peut la signaler, source à l’appui.',
  },
];
---

<Base titre="Accueil" large>
  <section class="grid items-center gap-10 lg:grid-cols-[1.3fr_1fr]">
    <div>
      <p class="entree brut-chip inline-block bg-secondary px-2 py-1 text-xs text-secondary-foreground">Présidentielle des 18 avril et 2 mai 2027</p>
      <h1 class="entree mt-4 text-4xl font-bold leading-[1.05] sm:text-6xl" style="--delai: 80ms">De quels programmes êtes-vous proche ?</h1>
      <p class="entree mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground" style="--delai: 160ms">
        {meta.nb_questions} affirmations sur {Object.keys(themes).length} grands thèmes, comparées aux positions de {meta.nb_candidats} candidats déclarés ou pressentis. Chaque position est sourcée par une citation exacte et relue par un humain.
      </p>
      <div class="entree mt-7 grid gap-3 sm:flex sm:flex-wrap sm:gap-4" style="--delai: 240ms">
        <a href={lien('test/')} class="brut-control brut-focus inline-flex h-13 items-center justify-center gap-2 bg-primary px-7 text-lg text-primary-foreground">Faire le test <Icone client:idle nom="arrow-right" taille={22} /></a>
        <a href={lien('questions/')} class="brut-control brut-focus inline-flex h-13 items-center justify-center gap-2 bg-background px-7 text-lg"><Icone client:idle nom="message-circle-more" taille={22} />Voir qui pense quoi</a>
      </div>
      <p class="mt-4 text-sm text-muted-foreground">De 2 à 12 minutes · sans inscription · rien n'est enregistré</p>
      <p class="mt-6 text-sm font-semibold">Proximité avec des programmes, pas une consigne de vote.</p>
    </div>
    <div class="entree relative" style="--delai: 300ms">
      <div class="brut-panel relative z-10 bg-card p-5 sm:p-6">
        <p class="text-xs font-bold tracking-wide text-muted-foreground uppercase">Exemple d'affirmation · {themes[exemple.theme]}</p>
        <p class="mt-2 font-serif text-2xl leading-snug font-semibold">{exemple.texte}</p>
        <ul class="mt-5 grid gap-2" aria-label="Échelle de réponse">
          {['2', '1', '0', '-1', '-2'].map((k, i) => (
            <li class="demo-choix brut-questionnaire-choice flex items-center gap-2.5 bg-background px-3 py-2 text-sm font-semibold" style={`--i: ${i}`}>
              <span class="flex size-4 shrink-0 items-center justify-center rounded-full border-[length:var(--brut-border)] border-current" aria-hidden="true"><span class="demo-point size-2 rounded-full"></span></span>
              {questions.echelle[k]}
            </li>
          ))}
        </ul>
        <p class="mt-3 text-sm text-muted-foreground">… ou « je passe ». Puis la boussole compare vos réponses aux positions sourcées des candidats.</p>
      </div>
      <div class="brut-panel absolute inset-0 translate-x-3 translate-y-3 bg-secondary sm:translate-x-4 sm:translate-y-4" aria-hidden="true"></div>
    </div>
  </section>

  <section class="mt-16" aria-label="Chiffres clés">
    <dl class="grid grid-cols-2 gap-4 lg:grid-cols-4" data-cascade>
      {[
        [String(meta.nb_questions), 'affirmations, sur 8 thèmes'],
        [String(meta.nb_candidats), 'candidats déclarés ou pressentis'],
        [String(meta.nb_positions), 'positions sourcées par une citation exacte'],
        ['0', 'cookie, traceur ou donnée collectée'],
      ].map(([n, l]) => (
        <div class="brut-surface flex flex-col-reverse bg-card p-4">
          <dt class="mt-1 text-sm text-muted-foreground">{l}</dt>
          <dd class="font-serif text-4xl font-bold tabular-nums sm:text-5xl" data-compteur={n}>{n}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mt-20" aria-labelledby="titre-diff">
    <h2 data-revele id="titre-diff" class="text-3xl font-bold">Ce qui distingue cette boussole</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">Toutes les boussoles électorales ne se valent pas. Voici ce qu'on peut vérifier ici, et ce qu'il est utile de demander à n'importe quel outil de ce genre.</p>
    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-cascade>
      {differences.map((d) => (
        <li class="survol brut-panel bg-card p-5" data-icone-parent>
          <span class="inline-flex size-11 items-center justify-center rounded-[var(--radius)] border-[length:var(--brut-border)] border-border bg-secondary text-secondary-foreground"><Icone client:visible nom={d.icone} taille={24} /></span>
          <h3 class="mt-3 font-sans text-lg font-bold">{d.titre}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{d.texte}</p>
        </li>
      ))}
    </ul>
    <p class="mt-6"><a class="lien inline-flex items-center gap-1.5 font-semibold" href={lien('methode/')}><Icone client:visible nom="flask" taille={18} />Lire la méthode et l'audit de neutralité</a></p>
  </section>

  <section class="mt-20" aria-labelledby="titre-etapes">
    <h2 data-revele id="titre-etapes" class="text-3xl font-bold">Comment ça marche</h2>
    <ol class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-cascade>
      {[
        ['Choisissez un mode', '8, 24 ou 40 questions. On peut passer au mode supérieur à la fin, sans recommencer.'],
        ['Répondez thème par thème', 'De « tout à fait d’accord » à « pas du tout d’accord ». On peut passer une question.'],
        ['Indiquez vos priorités', 'Trois thèmes au plus comptent double (ou triple s’ils sont décisifs pour vous).'],
        ['Lisez les sources', 'Classement avec marge, puis accords et désaccords, chacun avec la citation et le lien.'],
      ].map(([t, d], i) => (
        <li class="brut-surface bg-card p-5">
          <span class="flex size-9 items-center justify-center rounded-full border-2 border-border bg-primary font-bold text-primary-foreground" aria-hidden="true">{i + 1}</span>
          <h3 class="mt-3 font-sans font-bold">{t}</h3>
          <p class="mt-1 text-sm text-muted-foreground">{d}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-20" aria-labelledby="titre-candidats">
    <h2 data-revele id="titre-candidats" class="text-3xl font-bold">Les {candidats.length} candidats suivis</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">Par ordre alphabétique du nom de famille. La liste officielle sera arrêtée par le Conseil constitutionnel en mars 2027 ; d'ici là, la boussole suit les candidatures déclarées ou pressenties.</p>
    <ul class="mt-8 grid grid-cols-3 gap-4 sm:grid-cols-5 lg:grid-cols-9" data-cascade>
      {candidats.map((c) => (
        <li>
          <a href={lien(`candidats/${c.slug}/`)} class="survol-photo group block text-center">
            <Portrait slug={c.slug} nom={c.nom} taille="md" />
            <span class="mt-2 block text-xs font-semibold leading-tight group-hover:underline">{c.nom}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6"><a class="lien inline-flex items-center gap-1.5 font-semibold" href={lien('candidats/')}><Icone client:visible nom="users" taille={18} />Toutes les fiches, avec crédits photo</a></p>
  </section>

  <section class="mt-20 grid gap-6 lg:grid-cols-2" data-cascade>
    <div class="brut-panel bg-card p-6">
      <h2 class="text-2xl font-bold">Prochaines étapes</h2>
      <ul class="mt-4 grid gap-3">
        {prochaines.map((e) => (
          <li class="flex gap-4">
            <span class="w-28 shrink-0 text-sm font-bold">{dateFr(e.date)}</span>
            <span class="text-sm">{e.titre}</span>
          </li>
        ))}
      </ul>
      <p class="mt-5"><a class="lien inline-flex items-center gap-1.5 font-semibold" href={lien('calendrier/')}><Icone client:visible nom="calendar-days" taille={18} />Calendrier complet et sources officielles</a></p>
    </div>
    <div class="brut-panel bg-card p-6">
      <h2 class="text-2xl font-bold">Aussi dans Claude</h2>
      <p class="mt-3 text-sm text-muted-foreground">La boussole existe aussi comme skill pour Claude : même questionnaire, mêmes données, même calcul, en conversation. Vous pouvez aussi lui demander la position d'un candidat sur un sujet.</p>
      <p class="mt-5"><a class="lien inline-flex items-center gap-1.5 font-semibold" href={lien('skill-claude/')}><Icone client:visible nom="sparkles" taille={18} />Installer le skill</a></p>
      <p class="mt-2"><a class="lien inline-flex items-center gap-1.5 font-semibold" href={lien('classe/')}><Icone client:visible nom="graduation-cap" taille={18} />Utiliser la boussole en classe</a></p>
    </div>
  </section>
</Base>
