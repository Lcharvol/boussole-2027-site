---
import Base from '../../layouts/Base.astro';
import Test from '../../components/Test';
import { lien, listeQuestions, questions, themes } from '../../lib/donnees';
---

<Base titre="Faire le test" description="Le questionnaire de la Boussole présidentielle 2027 : 8, 24 ou 40 affirmations, thème par thème. Calcul dans votre navigateur, aucune donnée collectée.">
  <h1 class="text-4xl font-bold">Le test</h1>
  <p class="mt-3 max-w-2xl text-muted-foreground">
    Des affirmations sur 8 thèmes ; répondez de « tout à fait d'accord » à « pas du tout d'accord », ou passez. Les affirmations sont reprises mot pour mot, et les positions des candidats ne sont pas montrées pendant le test, pour ne pas influencer vos réponses.
  </p>
  <div class="mt-8">
    <Test client:load questions={listeQuestions} themes={themes} echelle={questions.echelle} version={questions.version} base={lien()} />
  </div>
  <noscript>
    <p class="brut-surface mt-6 bg-card p-4">Le test a besoin de JavaScript : le calcul se fait dans votre navigateur, pour que vos réponses ne soient jamais envoyées. Vous pouvez consulter sans JavaScript les <a class="lien" href={lien('questions/')}>positions des candidats, question par question</a>.</p>
  </noscript>
</Base>
