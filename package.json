{
  "name": "boussole-2027-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site vitrine de la Boussole présidentielle 2027 : boussole électorale neutre, sourcée, sans collecte de données.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "donnees": "node scripts/preparer-donnees.mjs",
    "dev": "npm run donnees -- --sans-audit && node scripts/images-partage.mjs && node scripts/images-portraits.mjs && astro dev",
    "build": "npm run donnees && node scripts/images-partage.mjs && node scripts/images-portraits.mjs && astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:concordance": "tsx scripts/concordance.ts",
    "liens": "node scripts/verifier-liens.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@fontsource/inter": "5.2.8",
    "@lhci/cli": "0.15.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.18.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.3.5",
    "marked": "16.4.1",
    "satori": "0.18.3",
    "sharp": "0.35.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/source-serif-4": "5.2.9",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
